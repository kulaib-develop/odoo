<odoo>
  <data>

    <record id="todo_task_view_form" model="ir.ui.view">
      <field name="name">todo_task.view.form</field>
      <field name="model">todo.task</field>
      <field name="arch" type="xml">
        <form string="">
          <sheet>

            <header>
              <field name="status" widget="statusbar" statusbar_visible="new,in_progress,completed"
                options="{'clickable': 1}" />
              <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                invisible="active" />
            </header>
            <div class="oe_title">
              <label for="name" />
              <h1>
                <field name="name" />
              </h1>
            </div>
            <group>
              <group>
                <field name="assign_to_id" />
                <field name="assign_to_email" />
                <field name="active" invisible="1" />
              </group>
              <group>
                <field name="due_date" />
                <field name="expected_complete_date" />
                <field name="total_subtasks" />
              </group>
            </group>
            <group>
              <field name="description" />
            </group>
            <notebook>
              <page name="sub_tasks" string="SubTasks">
                <field name="subtask_ids">
                  <list editable="bottom">
                    <field name="name" />i
                    <field name="start" />i
                    <field name="end" />i
                  </list>
                </field>
              </page>
            </notebook>
          </sheet>
          <chatter />

        </form>
      </field>
    </record>
    <record id="todo_task_view_search" model="ir.ui.view">
      <field name="name">todo_task.view.search</field>
      <field name="model">todo.task</field>
      <field name="arch" type="xml">
        <search>
          <!-- search -->
          <field name="name" />
          <field name="assign_to_id" />
          <field name="status" />
          <!-- filters -->
          <filter
            name="is_new" string="New" domain="[('status','=','new')]" />
          <filter name="is_progress"
            string="In Progress" domain="[('status', '=', 'in_progress')]" />
          <filter name="is_completed"
            string="Completed" domain="[('status', '=', 'completed')]" />
          <filter name="is_closed"
            string="Closed" domain="[('status', '=', 'closed')]" />
          <separator />
          <filter name="is_archived"
            string="Archived" domain="[('active', '=', False)]" />
          <!-- grouping -->
          <filter name="group_status"
            string="Status" context="{'group_by': 'status'}" />
        </search>
      </field>
    </record>

    <record model="ir.ui.view" id="todo_task_list">
      <field name="name">todo_task.view.list</field>
      <field name="model">todo.task</field>
      <field name="arch" type="xml">
        <list decoration-danger="(is_late)">
          <field name="name" />
          <field name="assign_to_id" />
          <field name="due_date" />
          <field name="expected_complete_date" />
          <field name="status" />
          <field name="is_late" column_invisible="True" />
          <field name="active" />
        </list>
      </field>
    </record>
    <record model="ir.actions.act_window" id="todo_task_action_window">
      <field name="name">Tasks</field>
      <field name="res_model">todo.task</field>
      <field name="view_mode">list,form</field>
    </record>
    <record id="todo_tasks_closed_action" model="ir.actions.server">
      <field name="name">Closed</field>
      <field name="model_id" ref="model_todo_task" />
      <field name="binding_model_id" ref="model_todo_task" />
      <field name="state">code</field>
      <field name="code">action = records.action_closed()</field>
    </record>
    <record id="check_complete_task_action" model="ir.cron">
      <field name="name">Task: check complete tasks</field>
      <field name="model_id" ref="model_todo_task" />
      <field name="state">code</field>
      <field name="interval_type">days</field>
      <field name="interval_number">1</field>
      <field name="active">True</field>
      <field name="code">model._cron_check_complete_task_date()</field>
    </record>
    <menuitem
      id="task_menu"
      name="Tasks"
      parent="todo_root_menu"
      action="todo_task_action_window"
    />
  </data>
</odoo>