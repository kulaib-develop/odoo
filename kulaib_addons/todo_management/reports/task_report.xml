<odoo>
    <data>
        <record id="action_report_todo_task" model="ir.actions.report">
            <field name="name">Task Report</field>
            <field name="model">todo.task</field>
            <!-- <field name="report_type">qweb-pdf</field> -->
            <field name="report_type">qweb-html</field>
            <field name="report_name">todo_management.task_report_template</field>
            <!-- <field name="report_file">report.name</field> -->
            <!-- <field name="print_report_name">'%s' % object.name</field> -->
            <field name="binding_model_id" ref="model_todo_task" />
            <field name="binding_type">report</field>
        </record>
        <template id="task_report_template">
            <t t-call="web.html_container">
                <!-- <t t-call="web.basic_layout"> -->
                <t t-call="web.external_layout">
                    <t t-foreach="docs" t-as="doc">
                        <div class="border mt-4 p-2 border-secondary rounded">
                            <h2>Task data</h2>
                            <div class="row row-cols-2 g-2">
                                <div>
                                    <span class="fw-bold">Name: </span>
                                    <t t-esc="doc.name"></t>
                                </div>
                                <div>
                                    <span class="fw-bold">Assign To: </span>
                                    <!-- <t t-esc="doc.assign_to_id.name"></t> -->
                                    <span t-field="doc.assign_to_id"></span>
                                </div>
                                <div>
                                    <span class="fw-bold">Due Date: </span>
                                    <t t-esc="doc.due_date"></t>
                                </div>
                                <div>
                                    <span class="fw-bold">Expected Complete Date: </span>
                                    <t t-esc="doc.expected_complete_date"></t>
                                </div>
                            </div>
                            <div class='mt-2'>
                                <div class="fw-bold">Description: </div>
                                <t class='small text-secondary' t-esc="doc.description"></t>
                            </div>
                        </div>
                        <br />
                        <h2>sub tasks</h2>
                        <table class='table w-100'>
                            <thead>
                                <th>name</th>
                                <th>start</th>
                                <th>end</th>
                            </thead>
                            <tbody>
                                <t t-foreach="doc.subtask_ids" t-as="subtask">
                                    <tr>
                                        <td>
                                            <t t-esc="subtask.name"></t>
                                        </td>
                                        <td>
                                            <t t-esc="subtask.start"></t>
                                        </td>
                                        <td>
                                            <span t-field="subtask.end"></span>
                                        </td>
                                    </tr>
                                </t>

                            </tbody>
                        </table>
                    </t>
                </t>
            </t>
        </template>
    </data>
</odoo>